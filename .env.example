# =============================================================================
# JC-Azure SRE Databricks Platform — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in the values for your environment.
# Never commit the `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# Azure CLI Authentication
# -----------------------------------------------------------------------------
# The project uses Azure CLI authentication (az login) for local development
# and Managed Identity for deployments in Azure. Service Principal credentials
# are no longer used since Phase 4 (OIDC adopted for Azure DevOps).
#
# To authenticate locally:
#   az login
#   az account set --subscription <subscription-id>

# Set to "true" to force the use of AzureCliCredential in the pipeline.
# This avoids interference from other credentials that
# DefaultAzureCredential would otherwise try first.
AZURE_USE_CLI=true

# -----------------------------------------------------------------------------
# Azure Key Vault
# -----------------------------------------------------------------------------
# URI of the Key Vault that stores the pipeline secrets.
# Obtained via: terraform output -raw key_vault_uri
AZURE_KEY_VAULT_URI=

# -----------------------------------------------------------------------------
# Application Insights
# -----------------------------------------------------------------------------
# The connection string is stored in Azure Key Vault, not in this file.
# Set this variable only for local debugging when Key Vault access is not
# available. Otherwise, leave it commented.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=dev
REGION=brazilsouth
RESOURCE_GROUP=dev-sredatabricks-rg

# -----------------------------------------------------------------------------
# Terraform Backend (used by CI/CD; not needed for local pipeline)
# -----------------------------------------------------------------------------
TF_STATE_STORAGE_ACCOUNT=
TF_STATE_CONTAINER=
TF_STATE_KEY=

# -----------------------------------------------------------------------------
# Databricks (used by notebooks and CLI; not needed for local pipeline)
# -----------------------------------------------------------------------------
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WORKSPACE_ID=

# -----------------------------------------------------------------------------
# Azure DevOps (used by pipelines; not needed for local development)
# -----------------------------------------------------------------------------
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=

# -----------------------------------------------------------------------------
# Observability (local development)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION_DAYS=15

# -----------------------------------------------------------------------------
# Azure OpenAI
# -----------------------------------------------------------------------------
# Azure OpenAI is not provisionable on Azure for Students subscriptions.
# When available, set AZURE_OPENAI_ENABLED=true and configure the endpoint.
# The pipeline falls back to a deterministic generator when disabled.
#
# See docs/architecture/adr-004-ai-integration.md for details.
AZURE_OPENAI_ENABLED=false
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini